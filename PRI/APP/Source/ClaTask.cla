{
    ;//__mdebugstop();
}

void CLA_LLC_V_Loop_Routine(void)
{
    claVoltLoop.member.reference = CPU_Vout_Ref;//CPU_Vout_Ref

    if (claDuty.sotcFlag == 0)
    {
        claVoltLoop.member.feedback = (long)((float)CLA_ADC_VOUT * 4.0f); //(long)CPU_LLC_Vout;
        claVoltLoop.member.error = claVoltLoop.member.reference - claVoltLoop.member.feedback;

        // High stop filter process
        claVoltLoop.member.hsFilter.un  = (float)claVoltLoop.member.error *  6.103515625e-5f;//CLA_Float_Qn_Divisor[claVoltLoop.member.qNotation & 0x0F];
        claVoltLoop.member.hsFilter.yn  = Default_CLA_Type_III_HS_B0 * claVoltLoop.member.hsFilter.un;
        claVoltLoop.member.hsFilter.yn += Default_CLA_Type_III_HS_B1 * claVoltLoop.member.hsFilter.un1;
        claVoltLoop.member.hsFilter.yn += Default_CLA_Type_III_HS_B2 * claVoltLoop.member.hsFilter.un2;
        claVoltLoop.member.hsFilter.yn -= Default_CLA_Type_III_HS_A1 * claVoltLoop.member.hsFilter.yn1;
        claVoltLoop.member.hsFilter.yn -= Default_CLA_Type_III_HS_A2 * claVoltLoop.member.hsFilter.yn2;

        claVoltLoop.member.hsFilter.un2 = claVoltLoop.member.hsFilter.un1;
        claVoltLoop.member.hsFilter.un1 = claVoltLoop.member.hsFilter.un;
        claVoltLoop.member.hsFilter.yn2 = claVoltLoop.member.hsFilter.yn1;
        claVoltLoop.member.hsFilter.yn1 = claVoltLoop.member.hsFilter.yn;

        // PI compensation process
        claVoltLoop.member.piControl.error = claVoltLoop.member.hsFilter.yn;
        claVoltLoop.member.piControl.pYn   = Default_CLA_Type_III_PI_KP * claVoltLoop.member.piControl.error;
        claVoltLoop.member.piControl.iYn   = Default_CLA_Type_III_PI_KI * claVoltLoop.member.piControl.error;
        claVoltLoop.member.piControl.iYn  += claVoltLoop.member.piControl.iYn1;
        claVoltLoop.member.piControl.iYn  += Default_CLA_Type_III_PI_KC * claVoltLoop.member.piControl.satError;
        claVoltLoop.member.piControl.iYn1 = claVoltLoop.member.piControl.iYn;
        claVoltLoop.member.piControl.piYn = claVoltLoop.member.piControl.pYn + claVoltLoop.member.piControl.iYn;

        if (claVoltLoop.member.piControl.piYn > Default_CLA_Type_III_PI_Limit)
            claVoltLoop.member.piControl.output = Default_CLA_Type_III_PI_Limit;
        else if (claVoltLoop.member.piControl.piYn < 0.0f)
            claVoltLoop.member.piControl.output = 0.0f;
        else
            claVoltLoop.member.piControl.output = claVoltLoop.member.piControl.piYn;
        claVoltLoop.member.piControl.satError = claVoltLoop.member.piControl.output - claVoltLoop.member.piControl.piYn;
        claVoltLoop.member.piControl.output *= Default_CLA_Type_III_PI_KA;
    }
    else
    {
        claVoltLoop.member.piControl.output = claDuty.iYn1Buff;
        claVoltLoop.member.piControl.iYn1 = claDuty.iYn1Buff * __meinvf32(Default_CLA_Type_III_PI_KA);
    }
}

void CLA_Llc_Pwm_Table(void)
{
#if(1)
    if (claVoltLoop.member.piControl.output < claVea.P0) //512
        claDuty.period = (long)claVea.S0;
    else if (claVoltLoop.member.piControl.output < claVea.P1)
        claDuty.period = (long)(claVoltLoop.member.piControl.output * claVea.m1 + claVea.b1);
    else if (claVoltLoop.member.piControl.output < claVea.P2)
        claDuty.period = (long)(claVoltLoop.member.piControl.output * claVea.m2 + claVea.b2);
    else if (claVoltLoop.member.piControl.output < claVea.P3)
        claDuty.period = (long)(claVoltLoop.member.piControl.output * claVea.m3 + claVea.b3);
    else
        claDuty.period = (long)(claVoltLoop.member.piControl.output * claVea.m4 + claVea.b4);

//    float claPiOutput = claVoltLoop.member.piControl.output;
//    long idx = (claPiOutput > claVea.P0) + (claPiOutput > claVea.P1) + (claPiOutput > claVea.P2) + (claPiOutput > claVea.P3);
//    claDuty.period = (long)(claPiOutput * mTablep[idx] + bTablep[idx]);

#else
    if (claVoltLoop.member.piControl.output < claVea.P0) //512
        claDuty.period = (long)claVea.S0; // 300k
    else if (claVoltLoop.member.piControl.output < claVea.P1)
        claDuty.period = (long)(claVoltLoop.member.piControl.output * claVea.m1 + claVea.b1);
    else if (claVoltLoop.member.piControl.output < claVea.P2)
        claDuty.period = (long)(claVoltLoop.member.piControl.output * claVea.m2 + claVea.b2);
    else
        claDuty.period = (long)(claVoltLoop.member.piControl.output * claVea.m3 + claVea.b3);

#endif
}

void CLA_Region_SR_Controller(void)
{
    if ((float)(claDuty.period) > 480.0) //LLC Region 2  480 -> 125kHz
    {
//        CMP_PhaseShift = (claDuty.period - 480 + 12);
        CMP_PhaseShift = (claDuty.period - 480 + 24);
        if (CMP_PhaseShift >= claDuty.priDutyLead - 10)//TBPRD*0.167 - 30 - 30
            CMP_PhaseShift = claDuty.priDutyLead - 10;//10

        DB_PhaseShift = CMP_PhaseShift;

    }
    else //SRC Region
    {
        if ((float)(claDuty.period) < 300.0) // > 220kHz
        {
            DB_PhaseShift = 0x1000;
        }
        else
        {
            CMP_PhaseShift = 12;//Early turn-off of SR
            DB_PhaseShift = 24;//Delay turn-on of SR
        }
    }
}

void CLA_Burst_Mode_Controller(void)
{
    if (claVoltLoop.member.piControl.output >= claVea.P0)
    {
        claCountBurst = 0;
        claBurstFlag = 0;
    }
    else if (claVoltLoop.member.piControl.output < claVea.P0 && (claBurstFlag == 0))
    {
        claCountBurst = 90 - claVoltLoop.member.piControl.output * Default_CLA_BURST_K;
        claBurstFlag = 1;
    }
    else
    {
        if (claCountBurst > 0)
        {
            claCountBurst--;
            claBurstFlag = 1;
        }
        else
        {
            claCountBurst = 0;
            claBurstFlag = 0;
        }
    }
}

void CLA_Llc_Pwm_Update(void)
{
    EPwm1Regs.TBPRD = claDuty.period;

    claDuty.priDutyLead = (long)((float)claDuty.period * 0.167);
    claDuty.priDutyLag  = claDuty.period - claDuty.priDutyLead;
    claDuty.priDutyMid  = (long)((float)claDuty.period * 0.5);

    EPwm1Regs.CMPA.all = claDuty.priDutyLead << 16;
    EPwm1Regs.CMPB.all = claDuty.priDutyLag  << 16;
    EPwm8Regs.CMPA.all = claDuty.priDutyLag  << 16;
    EPwm8Regs.CMPB.all = claDuty.priDutyLead << 16;
    EPwm4Regs.CMPA.all = claDuty.priDutyMid  << 16;
    EPwm4Regs.CMPB.all = claDuty.priDutyMid  << 16;

    EPwm1Regs.DBRED.all = claDuty.priDeadband;
    EPwm1Regs.DBFED.all = claDuty.priDeadband;
    EPwm8Regs.DBRED.all = claDuty.priDeadband;
    EPwm8Regs.DBFED.all = claDuty.priDeadband;
    EPwm4Regs.DBRED.all = claDuty.priDeadband;
    EPwm4Regs.DBFED.all = claDuty.priDeadband;

    claDuty.srDutyLead = (long)((float)claDuty.period * 0.167);
    claDuty.srDutyLag  = claDuty.period - claDuty.srDutyLead;
    claDuty.srDutyMid  = (long)((float)claDuty.period * 0.5);

    EPwm2Regs.CMPA.all = (claDuty.srDutyLead - (long)CMP_PhaseShift) << 16;
    EPwm2Regs.CMPB.all = (claDuty.srDutyLag  + (long)CMP_PhaseShift) << 16;
    EPwm7Regs.CMPA.all = (claDuty.srDutyLag  - (long)CMP_PhaseShift) << 16;
    EPwm7Regs.CMPB.all = (claDuty.srDutyLead + (long)CMP_PhaseShift) << 16;
    EPwm5Regs.CMPA.all = (claDuty.srDutyMid  - (long)CMP_PhaseShift) << 16;
    EPwm5Regs.CMPB.all = (claDuty.srDutyMid  + (long)CMP_PhaseShift) << 16;

    EPwm2Regs.DBRED.all = claDuty.srDeadband + DB_PhaseShift;
    EPwm2Regs.DBFED.all = claDuty.srDeadband + DB_PhaseShift;
    EPwm7Regs.DBRED.all = claDuty.srDeadband + DB_PhaseShift;
    EPwm7Regs.DBFED.all = claDuty.srDeadband + DB_PhaseShift;
    EPwm5Regs.DBRED.all = claDuty.srDeadband + DB_PhaseShift;
    EPwm5Regs.DBFED.all = claDuty.srDeadband + DB_PhaseShift;

    EPwm1Regs.GLDCTL2.bit.OSHTLD = 1;
}

void CLA_LLC_V_Loop_Reset(void)
{
    claVoltLoop.member.hsFilter.b0 = Default_CLA_Type_III_HS_B0;
    claVoltLoop.member.hsFilter.b1 = Default_CLA_Type_III_HS_B1;
    claVoltLoop.member.hsFilter.b2 = Default_CLA_Type_III_HS_B2;
    claVoltLoop.member.hsFilter.a1 = Default_CLA_Type_III_HS_A1;
    claVoltLoop.member.hsFilter.a2 = Default_CLA_Type_III_HS_A2;
    claVoltLoop.member.hsFilter.un = 0.0f;
    claVoltLoop.member.hsFilter.un1 = 0.0f;
    claVoltLoop.member.hsFilter.un2 = 0.0f;
    claVoltLoop.member.hsFilter.yn = 0.0f;
    claVoltLoop.member.hsFilter.yn1 = 0.0f;
    claVoltLoop.member.hsFilter.yn2 = 0.0f;
    claVoltLoop.member.piControl.kp = Default_CLA_Type_III_PI_KP;
    claVoltLoop.member.piControl.ki = Default_CLA_Type_III_PI_KI;
    claVoltLoop.member.piControl.kc = Default_CLA_Type_III_PI_KC;
    claVoltLoop.member.piControl.ka = Default_CLA_Type_III_PI_KA;
    claVoltLoop.member.piControl.max = Default_CLA_Type_III_PI_Limit;
    claVoltLoop.member.piControl.min = 0.0f;
    claVoltLoop.member.piControl.error = 0.0f;
    claVoltLoop.member.piControl.pYn = 0.0f;
    claVoltLoop.member.piControl.iYn = 0.0f;
    claVoltLoop.member.piControl.iYn1 = Default_CLA_iYn1;
    claVoltLoop.member.piControl.piYn = 0.0f;
    claVoltLoop.member.piControl.satError = 0.0f;
    claVoltLoop.member.piControl.output = 0.0f;
    claVoltLoop.member.reference = 0l;
    claVoltLoop.member.feedback = 0l;
    claVoltLoop.member.error = 0l;
    claVoltLoop.member.output = 0l;
    claVoltLoop.member.maximum = 16384;
    claVoltLoop.member.minimum = 0l;
    claVoltLoop.member.qNotation = 14;
    claVoltLoop.member.lpFilter.b0 = Default_CLA_VCS_LPF_B0;
    claVoltLoop.member.lpFilter.b1 = Default_CLA_VCS_LPF_B1;
    claVoltLoop.member.lpFilter.a1 = Default_CLA_VCS_LPF_A1;
    claVoltLoop.member.lpFilter.un = 0.0f;
    claVoltLoop.member.lpFilter.un1 = 0.0f;
    claVoltLoop.member.lpFilter.yn = 0.0f;
    claVoltLoop.member.lpFilter.yn1 = 0.0f;
    claVoltLoop.member.prControl.b0 = Default_CLA_PR_B0;
    claVoltLoop.member.prControl.b1 = Default_CLA_PR_B1;
    claVoltLoop.member.prControl.b2 = Default_CLA_PR_B2;
    claVoltLoop.member.prControl.a1 = Default_CLA_PR_A1;
    claVoltLoop.member.prControl.a2 = Default_CLA_PR_A2;
    claVoltLoop.member.prControl.un = 0.0f;
    claVoltLoop.member.prControl.un1 = 0.0f;
    claVoltLoop.member.prControl.un2 = 0.0f;
    claVoltLoop.member.prControl.yn = 0.0f;
    claVoltLoop.member.prControl.yn1 = 0.0f;
    claVoltLoop.member.prControl.yn2 = 0.0f;

    claVea.m0 = Default_CLA_VEA_M0;
    claVea.m1 = Default_CLA_VEA_M1;
    claVea.m2 = Default_CLA_VEA_M2;
    claVea.m3 = Default_CLA_VEA_M3;
    claVea.m4 = Default_CLA_VEA_M4;

    claVea.b0 = Default_CLA_VEA_B0;
    claVea.b1 = Default_CLA_VEA_B1;
    claVea.b2 = Default_CLA_VEA_B2;
    claVea.b3 = Default_CLA_VEA_B3;
    claVea.b4 = Default_CLA_VEA_B4;

    claVea.P0 = Default_CLA_VEA_P0;
    claVea.P1 = Default_CLA_VEA_P1;
    claVea.P2 = Default_CLA_VEA_P2;
    claVea.P3 = Default_CLA_VEA_P3;
    claVea.P4 = Default_CLA_VEA_P4;

    claVea.S0 = Default_CLA_VEA_S0;
    claVea.S1 = Default_CLA_VEA_S1;
    claVea.S2 = Default_CLA_VEA_S2;
    claVea.S3 = Default_CLA_VEA_S3;
    claVea.S4 = Default_CLA_VEA_S4;

    claVea.BurstK = Default_CLA_BURST_K;
    claVea.iYn1 = Default_CLA_iYn1;

    claDuty.period = (long)claVea.S0;
    claDuty.priDutyLead = claDuty.period * 0.167;
    claDuty.priDutyLag = claDuty.period - claDuty.priDutyLead;
    claDuty.priDutyMid = (long)((float)claDuty.period * 0.5);
    claDuty.priDeadband = 30;   //30=250ns   //36;  //36=300ns

    claDuty.srDutyLead = claDuty.period * 0.167;
    claDuty.srDutyLag = claDuty.period - claDuty.srDutyLead;
    claDuty.srDutyMid = (long)((float)claDuty.period * 0.5);
    claDuty.srDeadband = 30;   //30=250ns   //36;  //36=300ns

    claBurstFlag = 0;
    claCountBurst = 0;

    OutputLimit = 1.6f;
    FreqSSfinish = 0;

    claDuty.sotcFlag = 0;
}

void CLA_SOTC_Reset(void)
{
    countUp = 0.0;
    countDown = 0.0;
    flagUp = 0.0;
    flagDown = 0.0;
    countLatchUp = 0.0;
    countLatchDown = 0.0;
    countLimitUp = 0.0;
    countLimitDown = 0.0;
    countReset = 0.0;
}

void CLA_Variable_Table(void)
{
    claVea.m0 = Default_CLA_VEA_M0;
    claVea.m1 = Default_CLA_VEA_M1;
    claVea.m2 = Default_CLA_VEA_M2;
    claVea.m3 = Default_CLA_VEA_M3;
    claVea.m4 = Default_CLA_VEA_M4;

    claVea.b0 = Default_CLA_VEA_B0;
    claVea.b1 = Default_CLA_VEA_B1;
    claVea.b2 = Default_CLA_VEA_B2;
    claVea.b3 = Default_CLA_VEA_B3;
    claVea.b4 = Default_CLA_VEA_B4;

    claVea.P0 = Default_CLA_VEA_P0;
    claVea.P1 = Default_CLA_VEA_P1;
    claVea.P2 = Default_CLA_VEA_P2;
    claVea.P3 = Default_CLA_VEA_P3;
    claVea.P4 = Default_CLA_VEA_P4;

    claVea.S0 = Default_CLA_VEA_S0;
    claVea.S1 = Default_CLA_VEA_S1;
    claVea.S2 = Default_CLA_VEA_S2;
    claVea.S3 = Default_CLA_VEA_S3;
    claVea.S4 = Default_CLA_VEA_S4;

    claVea.BurstK = Default_CLA_BURST_K;
    claVea.iYn1 = Default_CLA_iYn1;
}

void CLA_SOTCDD(void)
{
    claBuff = (float) CLA_ADC_IOUT;

    claCurrentLog[4] = claCurrentLog[3];
    claCurrentLog[3] = claCurrentLog[2];
    claCurrentLog[2] = claCurrentLog[1];
    claCurrentLog[1] = claCurrentLog[0];
    claCurrentLog[0] = claBuff;

    claPeriodBuff = (float) claDuty.period;

    claFiltCurrentLog[4] = claFiltCurrentLog[3];
    claFiltCurrentLog[3] = claFiltCurrentLog[2];
    claFiltCurrentLog[2] = claFiltCurrentLog[1];
    claFiltCurrentLog[1] = claFiltCurrentLog[0];
    claFiltCurrentLog[0] = claBuff;

    claFiltError = claFiltCurrentLog[0] - claFiltCurrentLog[4];

    if (claCurrentLog[0] > claCurrentLog[1])
    {
        claDividend = claCurrentLog[1];
        claDivisor = claCurrentLog[0];
    }

    else
    {
        claDividend = claCurrentLog[0];
        claDivisor = claCurrentLog[1];
    }


    if (claDivisor < 1.0f)
        claDivisor = 1.0f;

    claBuffSqr = __sqrt(claDividend / claDivisor);
    claDeltaPeriod = (1.0f - claBuffSqr) * claPeriodBuff * 0.25f;

    if (claFiltError < 0.0f)
    {
        claDeltaPeriod = -claDeltaPeriod;
    }
    else
    {
        claDeltaPeriod = claDeltaPeriod * 0.5;
    }

    claPeriodBuff = claPeriodBuff + claDeltaPeriod;

    if (claPeriodBuff <= claVea.S0)     // 250k
    {
        claPeriodBuff = claVea.S0;
        claDuty.iYn1Buff = claVea.P0;
    }
    else if (claPeriodBuff < claVea.S1) // 143k
    {
        claDuty.iYn1Buff = claPeriodBuff - claVea.b1;
        claDuty.iYn1Buff = claDuty.iYn1Buff / claVea.m1;
    }
    else if (claPeriodBuff < claVea.S2) // 124k
    {
        claDuty.iYn1Buff = claPeriodBuff - claVea.b2;
        claDuty.iYn1Buff = claDuty.iYn1Buff / claVea.m2;
    }
    else if (claPeriodBuff < claVea.S3) // 104k
    {
        claDuty.iYn1Buff = claPeriodBuff - claVea.b3;
        claDuty.iYn1Buff = claDuty.iYn1Buff / claVea.m3;
    }
    else
    {
        claDuty.iYn1Buff = claVea.P3;
    }

    if (claLlcState.bit.softStart == 0)
    {
        if(claFiltError > 614.0f) //246/6A //205/5A //327/8A //409/10A //491/12A //532/13A //573/14A //614/15A //655/16A //819/20A //1023f/25A
        {
            claVoltLoop.member.piControl.iYn1 = claDuty.iYn1Buff * __meinvf32(Default_CLA_Type_III_PI_KA);
            claVoltLoop.member.piControl.satError = 0.0f;
            claDuty.sotcFlag = 1.0;
        }
        else if(claFiltError < -614.0f)
        {
            claVoltLoop.member.piControl.iYn1 = claDuty.iYn1Buff * __meinvf32(Default_CLA_Type_III_PI_KA);
            claVoltLoop.member.piControl.satError = 0.0f;
            claDuty.sotcFlag = 2.0;
        }
        else
        {
            claDeltaPeriod = 0.0;
            claDuty.sotcFlag = 0.0;
        }
    }
    else
    {
        claDeltaPeriod = 0.0;
        claDuty.sotcFlag = 0.0;
    }
}

void CLA_SOTCPACK(void)
{
    claBuff = (float) CLA_ADC_IOUT;

    claCurrentLog[4] = claCurrentLog[3];
    claCurrentLog[3] = claCurrentLog[2];
    claCurrentLog[2] = claCurrentLog[1];
    claCurrentLog[1] = claCurrentLog[0];
    claCurrentLog[0] = claBuff;

    claPeriodBuff = (float) claDuty.period;

    claFiltCurrentLog[4] = claFiltCurrentLog[3];
    claFiltCurrentLog[3] = claFiltCurrentLog[2];
    claFiltCurrentLog[2] = claFiltCurrentLog[1];
    claFiltCurrentLog[1] = claFiltCurrentLog[0];
    claFiltCurrentLog[0] = claBuff;

    claFiltError = claFiltCurrentLog[0] - claFiltCurrentLog[4];

    if (claCurrentLog[0] > claCurrentLog[1])
    {
        claDividend = claCurrentLog[1];
        claDivisor = claCurrentLog[0];
    }

    else
    {
        claDividend = claCurrentLog[0];
        claDivisor = claCurrentLog[1];
    }


    if (claDivisor < 1.0f)
        claDivisor = 1.0f;

    claBuffSqr = __sqrt(claDividend / claDivisor);
    claDeltaPeriod = (1.0f - claBuffSqr) * claPeriodBuff * 0.25f;

    if (claFiltError < 0.0f)
    {
        claDeltaPeriod = -claDeltaPeriod * 1.5;
    }
    else
    {
        claDeltaPeriod = claDeltaPeriod * 1.9;
    }

    claPeriodBuff = claPeriodBuff + claDeltaPeriod;

    if (claPeriodBuff <= claVea.S0)     // 250k
    {
        claPeriodBuff = claVea.S0;
        claDuty.iYn1Buff = claVea.P0;
    }
    else if (claPeriodBuff < claVea.S1) // 143k
    {
        claDuty.iYn1Buff = claPeriodBuff - claVea.b1;
        claDuty.iYn1Buff = claDuty.iYn1Buff / claVea.m1;
    }
    else if (claPeriodBuff < claVea.S2) // 124k
    {
        claDuty.iYn1Buff = claPeriodBuff - claVea.b2;
        claDuty.iYn1Buff = claDuty.iYn1Buff / claVea.m2;
    }
    else if (claPeriodBuff < claVea.S3) // 104k
    {
        claDuty.iYn1Buff = claPeriodBuff - claVea.b3;
        claDuty.iYn1Buff = claDuty.iYn1Buff / claVea.m3;
    }
    else
    {
        claDuty.iYn1Buff = claVea.P3;
    }

    if (claLlcState.bit.softStart == 0)
    {
        if(claFiltError > 532.0f) //205/5A //246/6A //327/8A //409/10A //491/12A //532/13A //573/14A //614/15A //655/16A //819/20A //1023f/25A
        {
            claVoltLoop.member.piControl.iYn1 = claDuty.iYn1Buff * __meinvf32(Default_CLA_Type_III_PI_KA);
            claVoltLoop.member.piControl.satError = 0.0f;
            claDuty.sotcFlag = 1.0;
        }
        else if(claFiltError < -205.0f)
        {
            claVoltLoop.member.piControl.iYn1 = claDuty.iYn1Buff * __meinvf32(Default_CLA_Type_III_PI_KA);
            claVoltLoop.member.piControl.satError = 0.0f;
            claDuty.sotcFlag = 2.0;
        }
        else
        {
            claDeltaPeriod = 0.0;
            claDuty.sotcFlag = 0.0;
        }
    }
    else
    {
        claDeltaPeriod = 0.0;
        claDuty.sotcFlag = 0.0;
    }
}

void CLA_AHB_V_Loop_Routine(void)
{
//    ahbVoltLoop.error =  (float)(1402 - CPU_AHB_Vout);
    ahbVoltLoop.error =  (float)(CPU_VCharge_Ref - CPU_AHB_Vout);
    ahbVoltLoop.pYn = ahbVoltLoop.kp * ahbVoltLoop.error;
    ahbVoltLoop.iYn = ahbVoltLoop.ki * ahbVoltLoop.error;
    ahbVoltLoop.iYn += ahbVoltLoop.iYn1;
    ahbVoltLoop.iYn += ahbVoltLoop.kc * ahbVoltLoop.satError;

    ahbVoltLoop.iYn1 = ahbVoltLoop.iYn;
    ahbVoltLoop.piYn = ahbVoltLoop.pYn + ahbVoltLoop.iYn;

    if (ahbVoltLoop.piYn > ahbVoltLoop.max)
        ahbVoltLoop.output = ahbVoltLoop.max;
    else if (ahbVoltLoop.piYn < ahbVoltLoop.min)
        ahbVoltLoop.output = 0;
    else
        ahbVoltLoop.output = ahbVoltLoop.piYn;
    ahbVoltLoop.satError = ahbVoltLoop.output - ahbVoltLoop.piYn;
    ahbVoltLoop.output *= ahbVoltLoop.ka;
}

void CLA_AHB_I_Loop_Routine(void)
{
//    ahbCurrLoop.error = (float)(600 - CPU_AHB_Iout);
    ahbCurrLoop.error = (float)(CPU_ICharge_Ref - CPU_AHB_Iout);
    ahbCurrLoop.pYn = ahbCurrLoop.kp * ahbCurrLoop.error;
    ahbCurrLoop.iYn = ahbCurrLoop.ki * ahbCurrLoop.error;
    ahbCurrLoop.iYn += ahbCurrLoop.iYn1;
    ahbCurrLoop.iYn += ahbCurrLoop.kc * ahbCurrLoop.satError;

    ahbCurrLoop.iYn1 = ahbCurrLoop.iYn;
    ahbCurrLoop.piYn = ahbCurrLoop.pYn + ahbCurrLoop.iYn;

    if (ahbCurrLoop.piYn > ahbCurrLoop.max)
        ahbCurrLoop.output = ahbCurrLoop.max;
    else if (ahbCurrLoop.piYn < ahbCurrLoop.min)
        ahbCurrLoop.output = ahbCurrLoop.min;
    else
        ahbCurrLoop.output = ahbCurrLoop.piYn;
    ahbCurrLoop.satError = ahbCurrLoop.output - ahbCurrLoop.piYn;
    ahbCurrLoop.output *= ahbCurrLoop.ka;
}

void CLA_AHB_Loop_Reset(void)
{
    ahbPeriod = 0;
    ahbPeriodvloop = 0;
    ahbPeriodiloop = 0;

    ahbVoltLoop.kp       = Default_AHB_V_PI_KP;
    ahbVoltLoop.ki       = Default_AHB_V_PI_KI;
    ahbVoltLoop.kc       = Default_AHB_V_PI_KC;
    ahbVoltLoop.ka       = Default_AHB_V_PI_KA;
    ahbVoltLoop.max      = Default_AHB_V_PI_Limit;
    ahbVoltLoop.min      = 0.0f;
    ahbVoltLoop.error    = 0.0f;
    ahbVoltLoop.pYn      = 0.0f;
    ahbVoltLoop.iYn      = 0.0f;
    ahbVoltLoop.iYn1     = 0.0f;
    ahbVoltLoop.piYn     = 0.0f;
    ahbVoltLoop.satError = 0.0f;
    ahbVoltLoop.output   = 0.0f;

    ahbCurrLoop.kp       = Default_AHB_I_PI_KP;
    ahbCurrLoop.ki       = Default_AHB_I_PI_KI;
    ahbCurrLoop.kc       = Default_AHB_I_PI_KC;
    ahbCurrLoop.ka       = Default_AHB_I_PI_KA;
    ahbCurrLoop.max      = Default_AHB_I_PI_Limit;
    ahbCurrLoop.min      = 0.0f;
    ahbCurrLoop.error    = 0.0f;
    ahbCurrLoop.pYn      = 0.0f;
    ahbCurrLoop.iYn      = 0.0f;
    ahbCurrLoop.iYn1     = 0.0f;
    ahbCurrLoop.piYn     = 0.0f;
    ahbCurrLoop.satError = 0.0f;
    ahbCurrLoop.output   = 0.0f;
}
