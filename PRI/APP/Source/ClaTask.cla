__interrupt void CLA_ADC_A1_ISR(void)//claBuckControl(void)
{
//    if (claLlcState.bit.softStart == 0)
        CLA_ADC_VOUT = AdcbResultRegs.ADCRESULT1; // AdcbResultRegs.ADCRESULT1; ADC_VO_COMP
//    else
//        CLA_ADC_VOUT = AdccResultRegs.ADCRESULT0; // AdccResultRegs.ADCRESULT0; ADC_VO_ORING

//    CLA_ADC_VOUT = AdccResultRegs.ADCRESULT0 * claLlcState.bit.softStart + AdcbResultRegs.ADCRESULT1 * (!claLlcState.bit.softStart);

    CLA_ADC_IOUT = AdcaResultRegs.ADCRESULT1;

    CLA_LLC_IOUT = AdcaResultRegs.ADCRESULT0;

    CLA_AHB_VOUT = AdccResultRegs.ADCRESULT1;
    CLA_AHB_IOUT = AdccResultRegs.ADCRESULT2;

    // Update Messages from CPU
    claLlcState.all = CPU_LLC_State;
    claAhbState.all = CPU_AHB_State;

    CLA_Variable_Table();

    switch(claMode)
    {
    case MODE_CHARGE:
        CLA_AHB_I_Loop_Routine();
        CLA_AHB_V_Loop_Routine();
        ahbPeriodiloop = (long)ahbCurrLoop.output;
        ahbPeriodvloop = (long)ahbVoltLoop.output;

        if(claAhbState.bit.ccEnableDrive && !claAhbState.bit.cvEnableDrive)
            ahbPeriod = ahbPeriodiloop;
        else if (claAhbState.bit.cvEnableDrive && !claAhbState.bit.ccEnableDrive)
            ahbPeriod = ahbPeriodvloop;
        else
        {
            if (ahbPeriodiloop < ahbPeriodvloop)
                ahbPeriod = ahbPeriodiloop;
            else
                ahbPeriod = ahbPeriodvloop;
        }

        #if (AHBTestMode)
                EPwm6Regs.CMPA.bit.CMPA = ahbTestPeriod;
        #else
                EPwm6Regs.CMPA.bit.CMPA = ahbPeriod;
        #endif
        break;

        case MODE_DISCHARGE:
            if(claLlcState.bit.enableDrive == 1)
            {
                if (!claLlcState.bit.sotcEngineerFlag)
//                    CLA_SOTCPACK();

                CLA_LLC_V_Loop_Routine();

                // if(claVoltLoop.member.piControl.output > OutputLimit)
                //     claVoltLoop.member.piControl.output = OutputLimit;

                claVoltLoop.member.piControl.output = __mminf32(claVoltLoop.member.piControl.output, 1.6f);
            }
            else
            {
                //High frequency start up
                claVoltLoop.member.piControl.output = Default_CLA_VEA_P0;
            }

            CLA_Llc_Pwm_Table();
//            CLA_Burst_Mode_Controller();

//            if ((claLlcState.bit.burst || claBurstFlag) && ((CLA_ADC_VOUT >= 3432) || (claLlcState.bit.sohOutFlag && CLA_ADC_VOUT >= 3410))) //3432 / 4095 * 472.478 = 395.98V //3410 / 4095 * 472.478 = 393.44V
//            {
//                claDuty.priDeadband = 0x2000; //0x3FFF;
//                claDuty.srDeadband = 0x2000; //0xFFFF;
//            }
//            else
//            {
                claDuty.priDeadband = 30;
                claDuty.srDeadband = 30;
//            }

            #if (FixFreq && LLCTestMode)
                //claDuty.period = 230; //260kHz
                claDuty.period = 300;//TBPRD_Test; //123kHz
                claDuty.srDeadband = 60;//0xFFFF;//SR_Deadband_Test;   //30=250ns   //36;  //36=300ns
                claDuty.priDeadband = 60;//SR_Deadband_Test;   //30=250ns   //36;  //36=300ns

            #endif

//            CLA_Region_SR_Controller();

            if (EPwm4Regs.TBSTS.bit.SYNCI)
            {
                CLA_Llc_Pwm_Update();
                EPwm4Regs.TBSTS.bit.SYNCI = 1;
            }
            break;

        case MODE_DEFAULT:
            CLA_LLC_V_Loop_Reset();
            CLA_AHB_Loop_Reset();
            EPwm6Regs.CMPA.bit.CMPA = ahbPeriod;

            break;
    }
    AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;
}

